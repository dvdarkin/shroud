<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
    <PackageProjectUrl>https://github.com/dvdarkin/shroud</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dvdarkin/shroud.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
